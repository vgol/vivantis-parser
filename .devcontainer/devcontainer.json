{
  "name": "vivantis-parser",
  "image": "python:3.14-slim-bookworm",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "UV_PYTHON": "3.14",
    "UV_SYSTEM_CERTS": "1"
  },
  "postCreateCommand": "uv sync --all-groups --system-certs",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      }
    }
  }
}
